```gitignore
# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Coverage
coverage/

# Temporary files
tmp/
temp/

# Editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
```